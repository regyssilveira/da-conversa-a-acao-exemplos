    {
      "name": "Verificar autorização",
      "id": "Verificar autorização",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ],
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst out = (motivo) => [{json:{...e,permitido:false,resultado:motivo}}];\nconst campos = ['pedido_id','destino','assunto','corpo','fonte_id','versao','aprovador','aprovador_permitido','destino_aprovado','assunto_aprovado','corpo_aprovado','agora_teste','expira_em'];\nif (campos.some(k => typeof e[k] !== 'string' || !e[k].trim())) return out('BLOQUEADO_CAMPO');\nif (e.decisao !== 'aprovado') return out(e.decisao === 'rejeitado' ? 'BLOQUEADO_REJEITADO' : 'BLOQUEADO_SEM_APROVACAO');\nif (e.aprovador !== e.aprovador_permitido) return out('BLOQUEADO_IDENTIDADE');\nconst agora = Date.parse(e.agora_teste), expira = Date.parse(e.expira_em);\nif (!Number.isFinite(agora) || !Number.isFinite(expira) || agora >= expira) return out('BLOQUEADO_EXPIRADO');\nif (e.destino !== e.destino_aprovado || e.assunto !== e.assunto_aprovado || e.corpo !== e.corpo_aprovado) return out('BLOQUEADO_CONTEUDO');\nconst chave = e.pedido_id+'-'+e.versao;\nif (typeof e.historico_chaves !== 'string') return out('BLOQUEADO_HISTORICO');\nconst historico = e.historico_chaves.split(',').map(x=>x.trim()).filter(Boolean);\nif (historico.includes(chave)) return out('BLOQUEADO_DUPLICADO');\nreturn [{json:{...e,chave_execucao:chave,permitido:true,resultado:'PRONTO_PARA_SIMULAR',historico_proposto:[...historico,chave].join(',')}}];"
      }
    },
